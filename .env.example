# Use only the Supabase Connect > Transaction pooler URI, with the dedicated gridlock_app role.
# URL-encode reserved characters in the password. No production value belongs in source control.
DATABASE_URL=postgresql://APP_ROLE.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
APP_ENV=production
APP_URL=https://YOUR-VERCEL-PROJECT.vercel.app
SESSION_TTL_SECONDS=7200
# Optional only for one-time CLI admin bootstrap (unset immediately afterward):
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Migration tooling uses separate, OWNER-level credentials, never the runtime role:
# MYSQL_SOURCE_URL=mysql://SOURCE_USER:URL_ENCODED_PASSWORD@SOURCE_HOST:SOURCE_PORT/SOURCE_DB
# MIGRATION_DATABASE_URL=postgresql://OWNER:URL_ENCODED_PASSWORD@DIRECT_OR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
